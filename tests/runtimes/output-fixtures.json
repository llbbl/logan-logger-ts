  {
    "id": "runtime-output/custom-destination",
    "runtimes": ["node", "bun", "deno", "browser"],
    "input": {
      "config": {
        "level": "debug",
        "format": "json",
        "timestamp": false,
        "colorize": false,
        "transports": [
          {
            "type": "custom",
            "options": {}
          }
        ]
      },
      "actions": [
        {
          "logger": 0,
          "level": "info",
          "message": "sent",
          "metadata": {
            "request": 1
          }
        }
      ]
    },
    "expect": {
      "console": [],
      "builds": 1,
      "contexts": [
        {
          "format": "json",
          "timestamp": false,
          "colorize": false
        }
      ],
      "writes": [
        {
          "timestamp": "2026-08-22T04:15:30.123Z",
          "level": 1,
          "message": "sent",
          "metadata": {
            "request": 1
          },
          "runtime": "node"
        }
      ]
    }
  },
  {
    "id": "runtime-output/child-shares-custom-transport",
    "runtimes": ["node", "bun", "deno", "browser"],
    "input": {
      "config": {
        "level": "debug",
        "format": "text",
        "timestamp": true,
        "colorize": false,
        "transports": [
          {
            "type": "custom",
            "level": "error",
            "options": {}
          }
        ]
      },
      "actions": [
        {
          "logger": 2,
          "level": "warn",
          "message": "filtered"
        },
        {
          "logger": 1,
          "level": "error",
          "message": "child error"
        },
        {
          "logger": 2,
          "level": "error",
          "message": "grandchild error"
        }
      ],
      "children": [
        {
          "request": 1
        },
        {
          "span": 2
        }
      ]
    },
    "expect": {
      "console": [],
      "builds": 1,
      "writes": [
        {
          "timestamp": "2026-08-22T04:15:30.123Z",
          "level": 3,
          "message": "child error",
          "metadata": {
            "request": 1
          },
          "runtime": "node"
        },
        {
          "timestamp": "2026-08-22T04:15:30.123Z",
          "level": 3,
          "message": "grandchild error",
          "metadata": {
            "request": 1,
            "span": 2
          },
          "runtime": "node"
        }
      ]
    }
  },
