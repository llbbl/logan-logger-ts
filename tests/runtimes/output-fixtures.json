[
  {
    "id": "runtime-output/json-no-styling",
    "runtimes": ["node", "bun", "deno", "browser"],
    "input": {
      "config": {
        "level": "debug",
        "format": "json",
        "timestamp": false,
        "colorize": true
      },
      "actions": [
        {
          "logger": 0,
          "level": "info",
          "message": "structured"
        }
      ]
    },
    "expect": {
      "console": [
        {
          "method": "info",
          "args": [
            "{\"timestamp\":\"2026-08-22T04:15:30.123Z\",\"level\":\"info\",\"message\":\"structured\",\"runtime\":\"node\"}"
          ]
        }
      ]
    }
  },
