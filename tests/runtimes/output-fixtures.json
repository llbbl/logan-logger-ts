  {
    "id": "runtime-output/error-explicit-platform-keys",
    "runtimes": ["node", "bun", "deno", "browser"],
    "input": {
      "config": {
        "level": "debug",
        "format": "json",
        "colorize": false
      },
      "actions": [
        {
          "level": "info",
          "message": "custom error",
          "metadata": {
            "error": {
              "$error": {
                "name": "Error",
                "message": "custom",
                "props": {
                  "line": 7,
                  "sourceURL": "caller-supplied.js"
                },
                "non_enumerable": ["line"]
              }
            }
          }
        }
      ]
    },
    "expect": {
      "console": [
        {
          "method": "info",
          "args": [
            "{\"timestamp\":\"2026-08-22T04:15:30.123Z\",\"level\":\"info\",\"message\":\"custom error\",\"runtime\":\"node\",\"metadata\":{\"error\":{\"name\":\"Error\",\"message\":\"custom\",\"line\":7,\"sourceURL\":\"caller-supplied.js\"}}}"
          ]
        }
      ]
    }
  }
